load("@rules_rocq_rust//rocq:defs.bzl", "rocq_library", "rocq_proof_test")
load(":kernel_check.bzl", "rocq_kernel_check")

# =============================================================================
# Core Semantic Model
# =============================================================================

# WebAssembly semantics. A rocq_library compiles each source in its own
# action whose inputs are only the deps' .vo files, so a file cannot import
# a sibling in the same target: TermSemantics.v imports WasmSemantics, hence
# the split into two libraries.
rocq_library(
    name = "wasm_semantics",
    srcs = ["semantics/WasmSemantics.v"],
    visibility = ["//visibility:public"],
)

# Term semantics (imports WasmSemantics)
rocq_library(
    name = "semantics",
    srcs = ["semantics/TermSemantics.v"],
    visibility = ["//visibility:public"],
    deps = [":wasm_semantics"],
)

# Alias for backwards compatibility
alias(
    name = "term_semantics",
    actual = ":semantics",
    visibility = ["//visibility:public"],
)

rocq_proof_test(
    name = "semantics_test",
    deps = [":semantics"],
)

# =============================================================================
# Optimization Proofs
# =============================================================================

# Constant folding proofs
rocq_library(
    name = "constant_folding",
    srcs = ["simplify/ConstantFolding.v"],
    deps = [
        ":wasm_semantics",
        ":term_semantics",
    ],
    visibility = ["//visibility:public"],
)

rocq_proof_test(
    name = "constant_folding_test",
    deps = [":constant_folding"],
)

# Algebraic identity proofs
rocq_library(
    name = "identity",
    srcs = ["simplify/Identity.v"],
    deps = [
        ":wasm_semantics",
        ":term_semantics",
    ],
    visibility = ["//visibility:public"],
)

rocq_proof_test(
    name = "identity_test",
    deps = [":identity"],
)

# Bitwise optimization proofs
rocq_library(
    name = "bitwise",
    srcs = ["simplify/Bitwise.v"],
    deps = [
        ":wasm_semantics",
        ":term_semantics",
        ":identity",
    ],
    visibility = ["//visibility:public"],
)

rocq_proof_test(
    name = "bitwise_test",
    deps = [":bitwise"],
)

# Strength reduction proofs
rocq_library(
    name = "strength_reduction",
    srcs = ["simplify/StrengthReduction.v"],
    deps = [
        ":wasm_semantics",
        ":term_semantics",
    ],
    visibility = ["//visibility:public"],
)

rocq_proof_test(
    name = "strength_reduction_test",
    deps = [":strength_reduction"],
)

# Fused/meld optimization proofs
# Covers the optimization passes specific to WebAssembly modules produced by
# component fusion: same-memory adapter collapse, adapter devirtualization,
# trivial call elimination, type/import dedup, dead function elimination.
rocq_library(
    name = "fused_optimization",
    srcs = ["simplify/FusedOptimization.v"],
    deps = [
        ":wasm_semantics",
        ":term_semantics",
    ],
    visibility = ["//visibility:public"],
)

rocq_proof_test(
    name = "fused_optimization_test",
    deps = [":fused_optimization"],
)

# Concrete call semantics for the fused passes (issue #169). Self-contained:
# no deps, so it does not wait on the slow TermSemantics build.
rocq_library(
    name = "fused_semantics",
    srcs = ["simplify/FusedSemantics.v"],
    visibility = ["//visibility:public"],
)

rocq_proof_test(
    name = "fused_semantics_test",
    deps = [":fused_semantics"],
)

# =============================================================================
# Master Correctness Theorem
# =============================================================================

rocq_library(
    name = "correctness",
    srcs = ["Correctness.v"],
    deps = [
        ":wasm_semantics",
        ":term_semantics",
        ":constant_folding",
        ":identity",
        ":bitwise",
        ":strength_reduction",
    ],
    visibility = ["//visibility:public"],
)

rocq_proof_test(
    name = "correctness_test",
    deps = [":correctness"],
)

# =============================================================================
# Existing Proof Libraries
# =============================================================================

# Stack signature proofs
rocq_library(
    name = "stack_proofs",
    srcs = glob(["stack/*.v"]),
    visibility = ["//visibility:public"],
)

rocq_proof_test(
    name = "stack_proofs_test",
    deps = [":stack_proofs"],
)

# Codec (parser/encoder) proofs
rocq_library(
    name = "codec_proofs",
    srcs = glob(["codec/*.v"]),
    visibility = ["//visibility:public"],
)

rocq_proof_test(
    name = "codec_proofs_test",
    deps = [":codec_proofs"],
)

# ISLE term conversion proofs
rocq_library(
    name = "isle_proofs",
    srcs = glob(["isle/*.v"]),
    visibility = ["//visibility:public"],
)

rocq_proof_test(
    name = "isle_proofs_test",
    deps = [":isle_proofs"],
)

# =============================================================================
# Aggregated Targets
# =============================================================================

# All simplification/optimization proofs
filegroup(
    name = "simplify_proofs",
    srcs = [
        ":constant_folding",
        ":identity",
        ":bitwise",
        ":strength_reduction",
        ":fused_optimization",
        ":fused_semantics",
    ],
    visibility = ["//visibility:public"],
)

# All semantic model proofs
filegroup(
    name = "semantics_proofs",
    srcs = [
        ":wasm_semantics",
        ":term_semantics",
    ],
    visibility = ["//visibility:public"],
)

# All proofs combined (filegroup for aggregation)
filegroup(
    name = "all_proofs",
    srcs = [
        # New semantic and optimization proofs
        ":wasm_semantics",
        ":term_semantics",
        ":constant_folding",
        ":identity",
        ":bitwise",
        ":strength_reduction",
        ":fused_optimization",
        ":fused_semantics",
        ":correctness",
        # Existing proofs
        ":stack_proofs",
        ":codec_proofs",
        ":isle_proofs",
        "//proofs/rust_verified:value_types",
        "//proofs/rust_verified:value_types_proofs",
        "//proofs/rust_verified:value_types_translated_proofs",
        "//proofs/rust_verified:stack_signature",
        "//proofs/rust_verified:stack_signature_proofs",
        "//proofs/rust_verified:isle_conversion",
        "//proofs/rust_verified:isle_conversion_proofs",
    ],
    visibility = ["//visibility:public"],
)

# Test target for all proofs
test_suite(
    name = "all_proofs_test",
    tests = [
        ":semantics_test",
        ":constant_folding_test",
        ":identity_test",
        ":bitwise_test",
        ":strength_reduction_test",
        ":fused_optimization_test",
        ":fused_semantics_test",
        ":correctness_test",
        ":stack_proofs_test",
        ":codec_proofs_test",
        ":isle_proofs_test",
    ],
)

# =============================================================================
# Kernel re-check (rocqchk) and assumption allowlist
# =============================================================================
#
# Every rocq_library under //proofs is the `library` or a `library_deps`
# entry of a check below; CI asserts that with a bazel query, so a library
# that nothing re-checks fails the job. rocqchk re-checks each listed
# library and everything it loads, and the action fails on any axiom,
# theory flag or unchecked definition that ASSUMPTIONS_ALLOWLIST.txt does
# not list.

rocq_kernel_check(
    name = "kernel_check_correctness",
    allowlist = "ASSUMPTIONS_ALLOWLIST.txt",
    library = ":correctness",
    library_deps = [
        ":wasm_semantics",
        ":semantics",
        ":constant_folding",
        ":identity",
        ":bitwise",
        ":strength_reduction",
    ],
)

rocq_kernel_check(
    name = "kernel_check_fused_optimization",
    allowlist = "ASSUMPTIONS_ALLOWLIST.txt",
    library = ":fused_optimization",
    library_deps = [
        ":wasm_semantics",
        ":semantics",
    ],
)

[
    rocq_kernel_check(
        name = "kernel_check_" + lib,
        allowlist = "ASSUMPTIONS_ALLOWLIST.txt",
        library = ":" + lib,
    )
    for lib in [
        "fused_semantics",
        "stack_proofs",
        "codec_proofs",
        "isle_proofs",
    ]
]

[
    rocq_kernel_check(
        name = "kernel_check_" + lib,
        allowlist = "ASSUMPTIONS_ALLOWLIST.txt",
        library = "//proofs/rust_verified:" + lib,
    )
    for lib in [
        "value_types_proofs",
        "stack_signature_proofs",
        "isle_conversion_proofs",
    ]
]

# The translated libraries are checked in //proofs/rust_verified, where the
# RocqOfRust alias is visible.
exports_files(["ASSUMPTIONS_ALLOWLIST.txt"])
