# WebAssembly fuzzing dictionary
# Magic bytes and common WASM patterns

# WASM magic number
"\x00asm"

# Version 1
"\x01\x00\x00\x00"

# Section IDs
# Custom section
"\x00"
# Type section
"\x01"
# Import section
"\x02"
# Function section
"\x03"
# Table section
"\x04"
# Memory section
"\x05"
# Global section
"\x06"
# Export section
"\x07"
# Start section
"\x08"
# Element section
"\x09"
# Code section
"\x0a"
# Data section
"\x0b"

# Value types
# i32
"\x7f"
# i64
"\x7e"
# f32
"\x7d"
# f64
"\x7c"
# funcref
"\x70"
# externref
"\x6f"

# Function type constructor
"\x60"

# Block types
# void
"\x40"

# Common instructions
# unreachable
"\x00"
# nop
"\x01"
# block
"\x02"
# loop
"\x03"
# if
"\x04"
# else
"\x05"
# end
"\x0b"
# br
"\x0c"
# br_if
"\x0d"
# br_table
"\x0e"
# return
"\x0f"
# call
"\x10"
# call_indirect
"\x11"

# Local/global ops
# local.get
"\x20"
# local.set
"\x21"
# local.tee
"\x22"
# global.get
"\x23"
# global.set
"\x24"

# Memory ops
# i32.load
"\x28"
# i64.load
"\x29"
# f32.load
"\x2a"
# f64.load
"\x2b"
# i32.store
"\x36"
# i64.store
"\x37"

# Constants
# i32.const
"\x41"
# i64.const
"\x42"
# f32.const
"\x43"
# f64.const
"\x44"

# Numeric ops
# i32.eqz
"\x45"
# i32.eq
"\x46"
# i32.ne
"\x47"
# i32.add
"\x6a"
# i32.sub
"\x6b"
# i32.mul
"\x6c"
# i32.div_s
"\x6d"
# i32.div_u
"\x6e"
# i32.and
"\x71"
# i32.or
"\x72"
# i32.xor
"\x73"
# i32.shl
"\x74"
# i32.shr_s
"\x75"
# i32.shr_u
"\x76"

# Drop and select
# drop
"\x1a"
# select
"\x1b"
