# Rust
target/
# Cargo.lock IS committed (#320): loom ships binaries, so the lock is part of
# the build's reproducibility story and dependency changes must arrive as
# reviewable diffs rather than as ambient resolution at CI time.
**/*.rs.bk
*.pdb

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
*.egg-info/
dist/
build/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Test artifacts (except test fixtures)
*.wasm
!tests/**/*.wasm
!loom-core/tests/**/*.wasm
*.wat
!tests/**/*.wat
!loom-core/tests/**/*.wat

# Root directory artifacts
/*.wasm
/*.wat
/*.txt

# Temporary files
*.tmp
*.bak
.cache/
*.z3-trace

# Bazel
bazel-bin
bazel-loom
bazel-out
bazel-testlogs
bazel-*

# Claude Code agent worktrees
.claude/worktrees/
